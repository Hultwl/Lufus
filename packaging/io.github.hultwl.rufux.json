{
  "app-id": "io.github.hultwl.rufux",
  "runtime": "org.gnome.Platform",
  "runtime-version": "48",
  "sdk": "org.gnome.Sdk",
  "command": "rufux",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=all"
  ],
  "modules": [
    {
      "name": "rufux",
      "buildsystem": "cmake",
      "config-opts": ["-DCMAKE_BUILD_TYPE=Release"],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/Hultwl/Rufux.git",
          "tag": "v1.0.0"
        }
      ]
    }
  ]
}
