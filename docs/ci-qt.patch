diff --git a/.github/workflows/appimage.yml b/.github/workflows/appimage.yml
index b3e0720..e64df59 100644
--- a/.github/workflows/appimage.yml
+++ b/.github/workflows/appimage.yml
@@ -19,7 +19,7 @@ jobs:
         run: |
           sudo apt-get update -qq
           sudo apt-get install -y -qq cmake gcc pkg-config file wget \
-            libgtk-4-dev libudev-dev libblkid-dev libssl-dev gettext curl \
+            qt6-base-dev libudev-dev libblkid-dev libssl-dev gettext curl \
             util-linux dosfstools exfatprogs e2fsprogs mtools ntfs-3g \
             syslinux libarchive-tools p7zip-full xorriso udisks2
 
@@ -37,18 +37,20 @@ jobs:
       - name: Fetch linuxdeploy
         run: |
           wget -q https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage
-          wget -q https://raw.githubusercontent.com/linuxdeploy/linuxdeploy-plugin-gtk/master/linuxdeploy-plugin-gtk.sh
